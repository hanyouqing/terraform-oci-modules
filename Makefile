.PHONY: help fmt fmt-check validate validate-prep validate-modules validate-examples validate-module lint lint-init lint-module security docs docs-module clean init plan apply list-modules list-examples install-tools oci-credentials-list oci-clean

# Default target
.DEFAULT_GOAL := help

# Variables
TERRAFORM_VERSION ?= 1.5.7
TF_VERSION_FILE := .terraform-version
# Absolute-path CLI config (filesystem_mirror does not expand ~). Created by validate-prep under .terraform/.
# Not exported globally: fmt/lint do not need it, and a literal ~ in plugin_cache_dir warns on every terraform command.
TF_CLI_CONFIG_LOCAL := $(CURDIR)/.terraform/terraformrc.local

# Top-level module dirs (same discovery as make docs): */main.tf
define list_module_dirs
for dir in */; do \
	dir=$${dir%/}; \
	[ -f "$$dir/main.tf" ] || continue; \
	printf '%s\n' "$$dir"; \
done
endef

# Example root dirs: unique directories under */examples/* that contain .tf
define list_example_dirs
find . -type f -name '*.tf' -path '*/examples/*' \
	-not -path '*/.terraform/*' -not -path '*/.terragrunt-cache/*' 2>/dev/null | \
	sed 's|/[^/]*$$||' | sort -u
endef

help: ## Show this help message
	@echo 'Usage: make [target]'
	@echo ''
	@echo 'Available targets:'
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "  %-20s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

oci-credentials-list: ## List account names under credentials/; switch with eval and scripts/oci-use.sh (see README)
	@bash -c 'source scripts/oci-use.sh && oci_use_list'

oci-clean: ## Dry-run resources blocking a compartment (COMPARTMENT=ocid APPLY=1 DELETE_COMPARTMENT=1 YES=1)
	@if [ -z "$(COMPARTMENT)" ]; then \
		echo "Usage: make oci-clean COMPARTMENT=ocid1.compartment.oc1..example [APPLY=1] [DELETE_COMPARTMENT=1] [YES=1]"; \
		echo "Dry-run unless APPLY=1. APPLY=1 also deletes child compartments. DELETE_COMPARTMENT=1 deletes the named compartment."; \
		exit 1; \
	fi
	./scripts/oci-clean.sh --compartment-id "$(COMPARTMENT)" \
		$(if $(filter 1 true yes,$(APPLY)),--apply,) \
		$(if $(filter 1 true yes,$(DELETE_COMPARTMENT)),--delete-compartment,) \
		$(if $(filter 1 true yes,$(YES)),--yes,)

fmt: ## Format all Terraform and Terragrunt HCL files
	@echo "Formatting all Terraform files..."
	@find . -type f -name "*.tf" -not -path "*/.terraform/*" -exec terraform fmt -recursive {} \;
	@if command -v terragrunt >/dev/null 2>&1; then \
		echo "Formatting Terragrunt HCL files..."; \
		terragrunt --working-dir terragrunt hcl fmt; \
	else \
		echo "terragrunt not found; skipping terragrunt hcl fmt."; \
	fi

fmt-check: ## Check if Terraform and Terragrunt HCL files are formatted
	@echo "Checking Terraform formatting..."
	@if ! terraform fmt -check -recursive; then \
		echo "Error: Some files are not formatted. Run 'make fmt' to fix."; \
		exit 1; \
	fi
	@if command -v terragrunt >/dev/null 2>&1; then \
		echo "Checking Terragrunt HCL formatting..."; \
		terragrunt --working-dir terragrunt hcl fmt --check; \
	else \
		echo "terragrunt not found; skipping terragrunt hcl fmt --check."; \
	fi

validate: validate-modules validate-examples ## Validate all modules and examples

validate-prep: ## Ensure oci filesystem_mirror + local CLI config (avoids GitHub SHA256SUMS timeouts)
	@mkdir -p "$$HOME/.terraform.d/plugin-cache" "$$HOME/.terraform.d/providers-mirror" "$(CURDIR)/.terraform"
	@# Mirror must be a different directory from plugin_cache_dir (Terraform forbids installing a cache dir to itself).
	@set -e; \
	cache_dir="$$HOME/.terraform.d/plugin-cache"; \
	mirror_dir="$$HOME/.terraform.d/providers-mirror"; \
	oci_rel="registry.terraform.io/oracle/oci"; \
	if [ -d "$$cache_dir/$$oci_rel" ]; then \
		mkdir -p "$$mirror_dir/$$oci_rel"; \
		for ver in "$$cache_dir/$$oci_rel"/*; do \
			[ -d "$$ver" ] || continue; \
			vname=$$(basename "$$ver"); \
			mkdir -p "$$mirror_dir/$$oci_rel/$$vname"; \
			for plat in "$$ver"/*; do \
				[ -d "$$plat" ] || continue; \
				pname=$$(basename "$$plat"); \
				dest="$$mirror_dir/$$oci_rel/$$vname/$$pname"; \
				mkdir -p "$$dest"; \
				for f in "$$plat"/*; do \
					[ -f "$$f" ] || continue; \
					bn=$$(basename "$$f"); \
					case "$$bn" in *_SHA256SUMS*) continue ;; esac; \
					if [ ! -e "$$dest/$$bn" ]; then cp "$$f" "$$dest/$$bn"; fi; \
				done; \
			done; \
		done; \
	fi; \
	umask 077; \
	printf '%s\n' \
		'# Generated by make validate-prep — under .terraform/ (gitignored).' \
		'plugin_cache_dir = "'$$cache_dir'"' \
		'' \
		'provider_installation {' \
		'  filesystem_mirror {' \
		'    path    = "'$$mirror_dir'"' \
		'    include = ["registry.terraform.io/oracle/oci"]' \
		'  }' \
		'  direct {}' \
		'}' \
		> "$(TF_CLI_CONFIG_LOCAL)"
	@echo "Using TF_CLI_CONFIG_FILE=$(TF_CLI_CONFIG_LOCAL)"

validate-modules: validate-prep ## Validate all modules (same dirs as make docs / list-modules)
	@echo "Validating all modules..."
	@set -e; \
	export TF_CLI_CONFIG_FILE="$(TF_CLI_CONFIG_LOCAL)"; \
	modules=$$($(list_module_dirs)); \
	if [ -z "$$modules" ]; then echo "No modules found."; exit 1; fi; \
	echo "Modules:"; \
	printf '%s\n' "$$modules" | sed 's/^/  - /'; \
	for dir in $$modules; do \
		echo "Validating $$dir/..."; \
		(cd "$$dir" && terraform init -backend=false -input=false >/dev/null && terraform validate); \
	done

validate-examples: validate-prep ## Validate all Terraform configs under */examples/*
	@echo "Validating all examples..."
	@set -e; \
	export TF_CLI_CONFIG_FILE="$(TF_CLI_CONFIG_LOCAL)"; \
	examples=$$($(list_example_dirs)); \
	if [ -z "$$examples" ]; then echo "No examples found."; exit 0; fi; \
	echo "Examples:"; \
	printf '%s\n' "$$examples" | sed 's/^/  - /'; \
	for dir in $$examples; do \
		echo "Validating $$dir/..."; \
		(cd "$$dir" && terraform init -backend=false -input=false >/dev/null && terraform validate); \
	done

validate-module: validate-prep ## Validate one module, or all (MODULE=vcn | MODULE=all); omit MODULE to list
	@modules=$$($(list_module_dirs)); \
	if [ -z "$(MODULE)" ]; then \
		echo "Usage:"; \
		echo "  make validate-module MODULE=all"; \
		printf '%s\n' "$$modules" | while read -r dir; do \
			echo "  make validate-module MODULE=$$dir"; \
		done; \
		exit 1; \
	fi; \
	if [ "$(MODULE)" = "all" ]; then \
		$(MAKE) validate-modules; \
	else \
		found=0; \
		for dir in $$modules; do \
			if [ "$$dir" = "$(MODULE)" ]; then found=1; break; fi; \
		done; \
		if [ "$$found" -ne 1 ]; then \
			echo "Unknown module: $(MODULE)"; \
			echo "Run 'make validate-module' or 'make list-modules' to list modules."; \
			exit 1; \
		fi; \
		echo "Validating $(MODULE)/..."; \
		export TF_CLI_CONFIG_FILE="$(TF_CLI_CONFIG_LOCAL)"; \
		(cd "$(MODULE)" && terraform init -backend=false -input=false >/dev/null && terraform validate); \
	fi

lint: ## Run tflint on each module (same dirs as make docs)
	@if ! command -v tflint >/dev/null 2>&1; then \
		echo "tflint not installed. Run 'make install-tflint' to install."; \
		exit 1; \
	fi
	@echo "Running tflint on all modules..."
	@$(MAKE) --no-print-directory lint-module MODULE=all

lint-init: ## Initialize tflint plugins
	@echo "Initializing tflint plugins..."
	@if command -v tflint > /dev/null; then \
		tflint --init --config "$(CURDIR)/.tflint.hcl"; \
	else \
		echo "tflint not installed. Run 'make install-tflint' to install."; \
		exit 1; \
	fi

lint-module: ## Lint one module, or all (make lint-module MODULE=vcn | MODULE=all); omit MODULE to list
	@if ! command -v tflint >/dev/null 2>&1; then \
		echo "tflint not installed. Run 'make install-tflint' to install."; \
		exit 1; \
	fi; \
	modules=$$($(list_module_dirs)); \
	if [ -z "$(MODULE)" ]; then \
		echo "Usage:"; \
		echo "  make lint-module MODULE=all"; \
		printf '%s\n' "$$modules" | while read -r dir; do \
			echo "  make lint-module MODULE=$$dir"; \
		done; \
		exit 1; \
	fi; \
	config=""; \
	if [ -f .tflint.hcl ]; then \
		config="--config $(CURDIR)/.tflint.hcl"; \
	fi; \
	if [ "$(MODULE)" = "all" ]; then \
		echo "Modules:"; \
		printf '%s\n' "$$modules" | sed 's/^/  - /'; \
		for dir in $$modules; do \
			echo "Linting $$dir/..."; \
			tflint $$config --chdir="$(CURDIR)/$$dir" || exit $$?; \
		done; \
	else \
		found=0; \
		for dir in $$modules; do \
			if [ "$$dir" = "$(MODULE)" ]; then \
				found=1; \
				break; \
			fi; \
		done; \
		if [ "$$found" -ne 1 ]; then \
			echo "Unknown module: $(MODULE)"; \
			echo "Run 'make lint-module' or 'make list-modules' to list modules."; \
			exit 1; \
		fi; \
		echo "Linting $(MODULE)/..."; \
		tflint $$config --chdir="$(CURDIR)/$(MODULE)"; \
	fi

security: ## Run security scans (tfsec and checkov)
	@echo "Running security scans..."
	@if command -v tfsec > /dev/null; then \
		if [ -f .tfsec.yml ]; then \
			tfsec --ignore-hcl-errors --config-file .tfsec.yml .; \
		else \
			tfsec --ignore-hcl-errors .; \
		fi; \
	else \
		echo "tfsec not installed. Run 'make install-tfsec' to install."; \
		exit 1; \
	fi
	@if command -v checkov > /dev/null; then \
		checkov -d .; \
	else \
		echo "checkov not installed. Run 'make install-checkov' to install."; \
	fi

tfsec: ## Run tfsec security scanner only
	@echo "Running tfsec..."
	@# tfsec 1.28 rejects Terraform check blocks. Ignore that parse error and still scan resources.
	@if command -v tfsec > /dev/null; then \
		if [ -f .tfsec.yml ]; then \
			tfsec --ignore-hcl-errors --config-file .tfsec.yml .; \
		else \
			tfsec --ignore-hcl-errors .; \
		fi; \
	else \
		echo "tfsec not installed. Run 'make install-tfsec' to install."; \
		exit 1; \
	fi

checkov: ## Run checkov security scanner only
	@echo "Running checkov..."
	@if command -v checkov > /dev/null; then \
		checkov -d .; \
	else \
		echo "checkov not installed. Run 'make install-checkov' to install."; \
		exit 1; \
	fi

docs: ## Generate documentation for all modules (lists each */ with main.tf)
	@echo "Generating documentation..."
	@if ! command -v terraform-docs >/dev/null 2>&1; then \
		echo "terraform-docs not installed. Run 'make install-terraform-docs' to install."; \
		exit 1; \
	fi
	@modules=$$($(list_module_dirs)); \
	echo "Modules:"; \
	printf '%s\n' "$$modules" | sed 's/^/  - /'; \
	for dir in $$modules; do \
		echo "Generating docs for $$dir/..."; \
		(cd "$$dir" && terraform-docs markdown --lockfile=false --output-file README.md --output-mode inject --sort-by name .) || true; \
	done

docs-module: ## Generate docs for one module, or all (MODULE=vcn | MODULE=all); omit MODULE to list
	@modules=$$($(list_module_dirs)); \
	if [ -z "$(MODULE)" ]; then \
		echo "Usage:"; \
		echo "  make docs-module MODULE=all"; \
		printf '%s\n' "$$modules" | while read -r dir; do \
			echo "  make docs-module MODULE=$$dir"; \
		done; \
		exit 1; \
	fi
	@if ! command -v terraform-docs >/dev/null 2>&1; then \
		echo "terraform-docs not installed. Run 'make install-terraform-docs' to install."; \
		exit 1; \
	fi
	@if [ "$(MODULE)" = "all" ]; then \
		$(MAKE) docs; \
	else \
		found=0; \
		for dir in $$($(list_module_dirs)); do \
			if [ "$$dir" = "$(MODULE)" ]; then found=1; break; fi; \
		done; \
		if [ "$$found" -ne 1 ]; then \
			echo "Unknown module: $(MODULE)"; \
			echo "Run 'make docs-module' or 'make list-modules' to list modules."; \
			exit 1; \
		fi; \
		echo "Generating docs for $(MODULE)/..."; \
		(cd "$(MODULE)" && terraform-docs markdown --lockfile=false --output-file README.md --output-mode inject --sort-by name .); \
	fi

init: ## Initialize Terraform in current directory
	terraform init

workspace: ## Switch to or create a workspace (usage: make workspace ENV=production)
	@if [ -z "$(ENV)" ]; then \
		echo "Error: ENV variable is required. Usage: make workspace ENV=production"; \
		echo "Valid environments: development, testing, staging, production"; \
		exit 1; \
	fi
	@./scripts/terraform-workspace.sh -e $(ENV)

workspace-list: ## List all workspaces
	@terraform workspace list

workspace-show: ## Show current workspace
	@terraform workspace show

plan: ## Run terraform plan
	terraform plan

terraform: ## Run terraform with project and environment (usage: make terraform -- plan -p demo/vpc -e production)
	@./scripts/terraform-plan.sh $(filter-out terraform,$(MAKECMDGOALS))

plan-workspace: ## Run terraform plan with workspace (usage: make plan-workspace ENV=production)
	@if [ -z "$(ENV)" ]; then \
		echo "Error: ENV variable is required. Usage: make plan-workspace ENV=production"; \
		exit 1; \
	fi
	@./scripts/terraform-workspace.sh -e $(ENV) && terraform plan

plan-project: ## Run terraform plan with project and environment (usage: make plan-project P=demo/vpc E=production)
	@if [ -z "$(P)" ] || [ -z "$(E)" ]; then \
		echo "Error: P and E variables are required"; \
		echo "Usage: make plan-project P=<project/path> E=<environment>"; \
		echo "Example: make plan-project P=demo/vpc E=production"; \
		exit 1; \
	fi
	@./scripts/terraform-plan.sh -p $(P) -e $(E)

apply: ## Run terraform apply (with confirmation)
	terraform apply

apply-workspace: ## Run terraform apply with workspace (usage: make apply-workspace ENV=production)
	@if [ -z "$(ENV)" ]; then \
		echo "Error: ENV variable is required. Usage: make apply-workspace ENV=production"; \
		exit 1; \
	fi
	@./scripts/terraform-workspace.sh -e $(ENV) && terraform apply

list-modules: ## List all modules (top-level dirs with main.tf; same set as docs/validate/lint)
	@echo "Available modules:"
	@modules=$$($(list_module_dirs)); \
	if [ -z "$$modules" ]; then echo "No modules found"; exit 0; fi; \
	printf '%s\n' "$$modules"

list-examples: ## List all examples (Terraform root dirs under */examples/*)
	@echo "Available examples:"
	@examples=$$($(list_example_dirs)); \
	if [ -z "$$examples" ]; then echo "No examples found"; exit 0; fi; \
	printf '%s\n' "$$examples"

clean: ## Clean all Terraform files (.terraform, .tfstate, etc.)
	@echo "Cleaning Terraform files..."
	@find . -type d -name ".terraform" -exec rm -rf {} + 2>/dev/null || true
	@find . -type f -name "*.tfstate" -delete 2>/dev/null || true
	@find . -type f -name "*.tfstate.*" -delete 2>/dev/null || true
	@find . -type f -name ".terraform.lock.hcl" -delete 2>/dev/null || true
	@find . -type f -name "crash.log" -delete 2>/dev/null || true
	@find . -type f -name "crash.*.log" -delete 2>/dev/null || true

install-tools: ## Install all recommended tools
	@echo "Installing recommended tools..."
	@make install-terraform-docs
	@make install-tflint
	@make install-tfsec
	@make install-checkov

install-terraform-docs: ## Install terraform-docs
	@if command -v terraform-docs > /dev/null; then \
		echo "terraform-docs already installed"; \
	else \
		echo "Installing terraform-docs..."; \
		if [ "$$(uname)" = "Darwin" ]; then \
			brew install terraform-docs; \
		else \
			echo "Please install terraform-docs manually: https://terraform-docs.io/user-guide/installation/"; \
		fi; \
	fi

install-tflint: ## Install tflint
	@if command -v tflint > /dev/null; then \
		echo "tflint already installed"; \
	else \
		echo "Installing tflint..."; \
		if [ "$$(uname)" = "Darwin" ]; then \
			brew install tflint; \
		else \
			echo "Please install tflint manually: https://github.com/terraform-linters/tflint"; \
		fi; \
	fi

install-tfsec: ## Install tfsec
	@if command -v tfsec > /dev/null; then \
		echo "tfsec already installed"; \
	else \
		echo "Installing tfsec..."; \
		if [ "$$(uname)" = "Darwin" ]; then \
			brew install tfsec; \
		else \
			echo "Please install tfsec manually: https://aquasecurity.github.io/tfsec/latest/getting-started/installation/"; \
		fi; \
	fi

install-checkov: ## Install checkov
	@if command -v checkov > /dev/null; then \
		echo "checkov already installed"; \
	else \
		echo "Installing checkov..."; \
		pip3 install checkov || echo "Please install checkov manually: pip install checkov"; \
	fi

check-versions: ## Check tool versions
	@echo "Tool versions:"
	@terraform version 2>/dev/null || echo "Terraform: not installed"
	@tflint --version 2>/dev/null || echo "tflint: not installed"
	@tfsec --version 2>/dev/null || echo "tfsec: not installed"
	@checkov --version 2>/dev/null || echo "checkov: not installed"
	@terraform-docs --version 2>/dev/null || echo "terraform-docs: not installed"

info: ## Show project information
	@echo "Terraform OCI Modules"
	@echo "====================="
	@echo "Modules: $$(make list-modules 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')"
	@echo "Examples: $$(make list-examples 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')"
	@echo "Current workspace: $$(terraform workspace show 2>/dev/null || echo 'default')"
	@echo ""
	@echo "Available workspaces:"
	@terraform workspace list 2>/dev/null || echo "  (no workspaces yet)"

pre-commit: fmt-check validate lint ## Run pre-commit checks

ci: fmt-check validate lint security ## Run full CI checks
