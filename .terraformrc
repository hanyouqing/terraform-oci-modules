# =============================================================================
# Terraform CLI Configuration
# =============================================================================
#
# Prefer: make validate / make validate-module
#   (writes .terraform/terraformrc.local with $HOME expanded + oci filesystem_mirror)
# Or:     export TF_CLI_CONFIG_FILE="$(pwd)/.terraformrc"
#
# Configures provider installation and plugin caching for OCI modules.
# =============================================================================

# -----------------------------------------------------------------------------
# Provider Installation
# -----------------------------------------------------------------------------
# make validate-prep adds a filesystem_mirror for registry.terraform.io/oracle/oci
# from ~/.terraform.d/plugin-cache so init can succeed when GitHub SHA256SUMS times out.

provider_installation {
  direct {}
}

# -----------------------------------------------------------------------------
# Plugin Cache (recommended)
# -----------------------------------------------------------------------------

# Leave plugin_cache_dir unset here. A literal ~ is not expanded in every Terraform build
# and prints a warning. `make validate*` writes an absolute path into
# .terraform/terraformrc.local and points TF_CLI_CONFIG_FILE at that file.

# -----------------------------------------------------------------------------
# OCI Authentication
# -----------------------------------------------------------------------------
#
# Terraform uses, in order:
# 1. Environment variables (OCI_TENANCY_OCID, OCI_USER_OCID, OCI_FINGERPRINT, OCI_PRIVATE_KEY_PATH)
# 2. OCI config file (~/.oci/config)
# 3. Instance principal (on OCI compute)
# 4. Resource principal (Functions/Container Instances)
#
# See .env.sh.example for environment variable setup.
#
